APP_ENV=development
DATABASE_URL=sqlite:///./data/code-retro.db
PUBLIC_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
# 실제 AI 요청은 명시적으로 활성화한 뒤에만 실행됩니다.
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GITHUB_TOKEN=
MAX_FILES=300
MAX_TOTAL_BYTES=5242880
AI_DAILY_TOKEN_LIMIT=200000
AI_MAX_CALLS_PER_JOB=24
AI_MAX_OUTPUT_TOKENS=5000
JOB_LEASE_SECONDS=180
TRUST_PROXY_HEADERS=false
GLOBAL_PROJECT_LIMIT=30
DATABASE_LIMIT_BYTES=314572800
